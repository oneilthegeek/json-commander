{
  "name": "love-lives-here",
  "version": "1.0.0",
  "private": true,
  "description": "Love Lives Here storefront, order management and Gold Card experiences",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "staff:create": "tsx scripts/create-staff.ts",
    "images": "tsx scripts/extract-images.ts",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "mock:paystack": "tsx tests/mocks/paystack-server.ts",
    "retention": "tsx scripts/retention.ts",
    "outbox": "tsx scripts/flush-outbox.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "libphonenumber-js": "1.13.16",
    "next": "15.5.29",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.1",
    "@types/pg": "8.15.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.11",
    "sharp": "0.35.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "postcss": "8.5.33"
  }
}
