# ---------------------------------------------------------------
# Love Lives Here — environment variables. Copy to .env and fill in.
# NEVER commit real values. Server-only unless prefixed NEXT_PUBLIC_.
# ---------------------------------------------------------------

# Public base URL (used for Paystack callback, links in emails, NFC URLs, SEO canonicals)
APP_URL=http://localhost:3000

# PostgreSQL. Use a least-privilege role that owns only this database.
DATABASE_URL=postgres://llh_app:CHANGE_ME@127.0.0.1:5432/llh
# Set to "require" for managed Postgres providers that need TLS
DATABASE_SSL=

# 32+ random bytes, base64. Signs short-lived tracking cookies and CSRF-free tokens.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_SECRET=CHANGE_ME

# --- Paystack (https://dashboard.paystack.com/#/settings/developers) ---
# Use sk_test_ keys in development. The secret key is used server-side only
# (initialize, verify, refund, and webhook HMAC verification).
PAYSTACK_SECRET_KEY=
# Leave unset in production. Tests point this at a local mock.
PAYSTACK_BASE_URL=https://api.paystack.co

# --- Newsletter (Dear Lovers) ---
# "substack" = official hosted Substack signup (no API; we hand the visitor to Substack)
# "mailchimp" = Mailchimp Marketing API with double opt-in
NEWSLETTER_PROVIDER=substack
# e.g. https://fromthelovers.substack.com  (verify the exact publication URL first)
SUBSTACK_PUBLICATION_URL=
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
# Override only for tests
MAILCHIMP_BASE_URL=

# --- Transactional email (optional). Without it, notifications are queued in the
# admin outbox and staff send them by WhatsApp/email manually. ---
RESEND_API_KEY=
EMAIL_FROM="Love Lives Here <always@loveliveshereng.com>"

# Optional: incoming-webhook URL (Slack, Discord, Google Chat) for operational alerts:
# server errors, payment mismatches, duplicate payments, failed emails, stock shortfalls.
ALERT_WEBHOOK_URL=

# Optional privacy-friendly page analytics in addition to first-party events
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
